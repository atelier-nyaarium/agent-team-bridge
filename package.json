{
	"name": "switchboard",
	"version": "8.7.6",
	"private": true,
	"type": "module",
	"scripts": {
		"start:gateway": "bun run src/main-gateway.ts",
		"start:mcp": "bun run src/main-mcp.ts",
		"start:host-daemon": "bun run src/main-host-daemon.ts",
		"build": "bun run scripts/build.ts",
		"lint": "bun scripts/lint.ts",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"gen:fixtures": "bun scripts/gen-wire-fixtures.ts",
		"check:fixtures": "bun scripts/check-wire-fixtures.ts",
		"check:pinning": "bun run scripts/check-pinning-runtime.ts",
		"check:boot": "bun run scripts/check-boot-runtime.ts",
		"postinstall": "bun scripts/link-lexicon.mjs || node scripts/link-lexicon.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
		"qrcode-generator": "2.0.4",
		"unbash": "4.0.10",
		"vscode-jsonrpc": "9.0.1",
		"ws": "8.21.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/ws": "8.18.1",
		"bun-types": "1.3.14",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	},
	"overrides": {
		"fast-uri": "3.1.2",
		"hono": "4.12.23",
		"ip-address": "10.2.0",
		"qs": "6.15.2"
	}
}
