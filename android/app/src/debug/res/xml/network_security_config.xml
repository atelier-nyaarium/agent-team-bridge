<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allow cleartext to the emulator host loopback so the STTS
     fixture lap (python http.server on 10.0.2.2) is reachable. Release builds
     have no network security config and stay HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
